# Local publishing. Set 0.0.0.0 to expose the port on the server's interfaces.
STUDIO_BIND_IP=127.0.0.1
STUDIO_PORT=9090

# Required: set your own password and a persistent random session secret.
STUDIO_AUTH_MODE=users
SITE_PASSWORD=
STUDIO_SESSION_SECRET=
STUDIO_SESSION_TTL=43200
STUDIO_FRAME_ANCESTORS=https://devbim.com http://localhost:* http://127.0.0.1:*

# Optional expiry (YYYY-MM-DD), empty means no expiry.
SITE_VALID_UNTIL=

# Global key for the owner/admin. Ordinary users need their own keys in /admin.
IMAGEROUTER_API_KEY=
# Only needed for model-management authorization in password mode.
ADMIN_PASSWORD=

# SSO only: shared signing secret with the integrating website.
STUDIO_JWT_SECRET=

# External design-code website. Empty values leave its integration unconfigured.
DESIGN_CODE_URL=
DESIGN_CODE_ACCESS_CODE=

# Optional overrides. Uncomment and set actual ImageRouter catalog model IDs.
# PROMPT_ENHANCER_MODEL=
# THREED_MODEL=
# THREED_ANALYSIS_MODEL=
# THREED_REPAIR_MODEL=
# THREED_VERIFY_MODEL=
# THREED_ESCALATION_MODEL=
# THREED_ENSEMBLE_MODEL=
# THREED_REFEREE_MODEL=

# Keep the application's existing verification and ensemble behavior.
THREED_VERIFY=1
THREED_VERIFY_ITERS=1
THREED_ENSEMBLE=1
THREED_MAX_CALLS_PER_ATTEMPT=6
