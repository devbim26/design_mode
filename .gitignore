# Виртуальное окружение и тяжёлые артефакты — в репозиторий не входят
venv/
dist_original_backup/

# Служебные логи
*.log

# Данные приложения (БД, модели, выходные изображения) — кроме конфига
data/*
!data/invokeai.yaml

# Секреты (ключ ImageRouter, админский пароль) — в репозиторий не входят
.env

# Служебные папки инструментов
.playwright-mcp/
__pycache__/
